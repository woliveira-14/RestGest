# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
VITE_APP_NAME=RestGest

# Session
SESSION_DRIVER=cookie

# Database
# Use "sqlite" to run locally without any extra setup, or "mssql" to connect
# to a Microsoft SQL Server instance via the Tedious driver.
DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_DATABASE=restgest